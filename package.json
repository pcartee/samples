{
  "name": "sample-writing",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "setup": "npm install && node scripts/docs-quality/setup.mjs",
    "prepare": "husky",
    "lint:docs": "node scripts/docs-quality/check.mjs --base origin/main",
    "lint:docs:all": "node scripts/docs-quality/check.mjs --all",
    "check:links": "docusaurus build && node --no-warnings scripts/docs-quality/links.mjs internal",
    "check:links:external": "node scripts/docs-quality/links.mjs external --base origin/main"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "cspell": "10.5.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "markdownlint-cli2": "0.24.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "core-js@3.49.0": true
  },
  "overrides": {
    "serialize-javascript": "^7.1.2",
    "uuid": "^11.1.1"
  },
  "lint-staged": {
    "docs/**/*.{md,mdx}": "node scripts/docs-quality/check.mjs --staged",
    ".lycheeignore": "node scripts/docs-quality/check.mjs --staged --checks suppressions"
  }
}
